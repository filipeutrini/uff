source("~/Área de trabalho/UFF/estatistica/trabalho/trabalho.r")
# PREPARAÇÃO
if (!require(rstudioapi)) install.packages("rstudioapi")
library(rstudioapi)
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
setwd("dados")
base_total = read.csv("diabetes_risk.csv")
base_total = base_total[,-c(1, 4, 5, 6, 8, 9, 10, 11, 15, 16, 17)]
amplitude = function(quartis) {
minimo = quartis[1]
maximo = quartis[5]
amp = maximo - minimo
return(as.numeric(amp))
}
assimetria = function(x) {
x = x[is.finite(x)]
n = length(x)
if (n < 3) {
stop("Sao necessarios pelo menos 3 valores.")
}
m = mean(x)
s = sd(x)
if (s == 0) {
stop("Desvio padrao zero: assimetria indefinida.")
}
g1 = sum((x - m)^3) / n / (sqrt(sum((x - m)^2) / n)^3)
# ajuste amostral
G1 = sqrt(n * (n - 1)) / (n - 2) * g1
return(G1)
}
curtose_excess = function(x) {
x = x[is.finite(x)]
n = length(x)
if (n < 4) {
stop("São necessarios pelo menos 4 valores.")
}
m = mean(x)
s2_n = sum((x - m)^2) / n
if (s2_n == 0) {
stop("Variancia zero: curtose indefinida.")
}
g2 = sum((x - m)^4) / n / (s2_n^2) - 3
# ajuste amostral
G2 = ((n - 1) / ((n - 2) * (n - 3))) * ((n + 1) * g2 + 6)
return(G2)
}
#TRADUÇÃO DOS DADOS E REMOÇÃO DOS NA
base_total$gender <- factor(base_total$gender,
levels = c("Male", "Female", "Other"),
labels = c("Homem", "Mulher", "Outro"))
base_total$physical_activity_level <- factor(base_total$physical_activity_level,
levels = c("Active", "Moderate", "Sedentary"),
labels = c("Ativo", "Moderado", "Sendentário"))
base_total$income_bracket <- factor(base_total$income_bracket,
levels = c("High", "Middle", "Low"),
labels = c("Alta", "Média", "Baixa"),
exclude = "")
base_total$diabetes_risk <- factor(base_total$diabetes_risk,
levels = c("High", "Moderate", "Low"),
labels = c("Alto", "Moderado", "Baixo"))
base_total = na.omit(base_total)
# SELEÇÃO DA AMOSTRA
linhas = nrow(base_total)
variavel = base_total$fasting_blood_sugar
0.01*mean(variavel)
erro = 1.7
tamanho_da_amostra = ((1.96^2)*var(variavel))/(erro^2)
set.seed(1234)
amostra = sample(1:linhas, tamanho_da_amostra)
dados = base_total[amostra,]
nrow(dados)
# ANÁLISE DAS VARIÁVEIS
# IDADE (VNC)
idades = dados$age
media_idade = mean(idades)
var_idade = var(idades)
desv_idade = sd(idades)
quartis_idade = quantile(idades)
amplitude_idade = amplitude(quartis_idade)
ass_idade = assimetria(idades)
curtose_excess_idade = curtose_excess(idades)
hist(idades, freq = FALSE,
main = "Histograma de Idade",
xlab = "Idade",
ylab = "Df",
col = "gray80"
)
# GÊNERO (VCN)
generos = dados$gender
ni_gen = table(generos)
fi_gen = prop.table(ni_gen)
Ni_gen = cumsum(ni_gen)
Fi_gen = cumsum(fi_gen)
tabela_generos <- data.frame(
Genero = names(ni_gen),
ni = as.numeric(ni_gen),
fi = as.numeric(fi_gen),
Ni = as.numeric(Ni_gen),
Fi = as.numeric(Fi_gen)
)
tabela_generos
par(cex=1.5)
pie(fi_gen,
main = "Gráfico de Setores de Gêneros",
col = c("gray60", "gray80", "gray90"),
)
legend("topright",
legend = paste(100*round(fi_gen,3),"%"),
fill = c("gray60", "gray80", "gray90"),
)
# NÍVEL DE ATIVIDADE FÍSICA (VCO)
niveis_ativ = dados$physical_activity_level
ni_nivel_ativ = table(niveis_ativ)
fi_nivel_ativ = prop.table(ni_nivel_ativ)
Ni_nivel_ativ = cumsum(ni_nivel_ativ)
Fi_nivel_ativ = cumsum(fi_nivel_ativ)
tabela_nivel_ativ <- data.frame(
Atividade = names(ni_nivel_ativ),
ni = as.numeric(ni_nivel_ativ),
fi = as.numeric(fi_nivel_ativ),
Ni = as.numeric(Ni_nivel_ativ),
Fi = as.numeric(Fi_nivel_ativ)
)
tabela_nivel_ativ
pie(fi_nivel_ativ,
main = "Gráfico de Setores de Atividade Física",
col = c("gray60", "gray80", "gray90"),
)
legend("topright",
legend = paste(100*round(fi_nivel_ativ,3),"%"),
fill = c("gray60", "gray80", "gray90"),
)
# NÍVEL DE STRESS (VND)
stress = dados$stress_level
ni_stress = table(stress)
fi_stress = prop.table(ni_stress)
Ni_stress = cumsum(ni_stress)
Fi_stress = cumsum(fi_stress)
tabela_stress <- data.frame(
Estresse = names(ni_stress),
ni = as.numeric(ni_stress),
fi = as.numeric(fi_stress),
Ni = as.numeric(Ni_stress),
Fi = as.numeric(Fi_stress)
)
tabela_stress
hist(stress, freq = FALSE,
main = "Histograma de Nível de Estresse",
xlab = "Nível de estresse",
ylab = "Df",
col = "gray80"
)
# AÇÚCAR NO SANGUE EM JEJUM (VNC)
glicose = dados$fasting_blood_sugar
media_glicose = mean(glicose)
var_glicose = var(glicose)
desv_glicose = sd(glicose)
quartis_glicose = quantile(glicose)
amplitude_glicose = amplitude(quartis_glicose)
ass_glicose = assimetria(glicose)
curtose_excess_glicose = curtose_excess(glicose)
boxplot(glicose,
main = "Boxplot de Glicose no Sangue",
xlab = "Glicose no sangue (mg/dL)",
col = "gray80",
horizontal = TRUE
)
# HEMOGLOBINA GLICADA (VNC)
hemoglobina = dados$hba1c_level
media_hemoglobina = mean(hemoglobina)
var_hemoglobina = var(hemoglobina)
desv_hemoglobina = sd(hemoglobina)
quartis_hemoglobina = quantile(hemoglobina)
amplitude_hemoglobina = amplitude(quartis_hemoglobina)
ass_hemoglobina = assimetria(hemoglobina)
curtose_excess_hemoglobina = curtose_excess(hemoglobina)
boxplot(hemoglobina,
main = "Boxplot de Hemoglobina Glicada",
xlab = "Hemoglobina glicada (%)",
col = "gray80",
horizontal = TRUE
)
# RISCO DE DIABETES (VCO)
risco_diabetes = dados$diabetes_risk
ni_risco = table(risco_diabetes)
fi_risco = prop.table(ni_risco)
Ni_risco = cumsum(ni_risco)
Fi_risco = cumsum(fi_risco)
tabela_risco <- data.frame(
Risco = names(ni_risco),
ni = as.numeric(ni_risco),
fi = as.numeric(fi_risco),
Ni = as.numeric(Ni_risco),
Fi = as.numeric(Fi_risco)
)
tabela_risco
pie(fi_risco,
main = "Gráfico de Setores de Risco",
col = c("gray60", "gray80", "gray90"),
)
legend("topright",
legend = paste(100*round(fi_risco,3),"%"),
fill = c("gray60", "gray80", "gray90"),
)
source("~/Área de trabalho/UFF/estatistica/trabalho/trabalho.r", echo = TRUE)
